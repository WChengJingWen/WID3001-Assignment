cabal-version:       2.4
name:                WID3001-Assignment
version:             0.1.0.0

library
  exposed-modules:     
    AST,
    Parser,
    Tokenizer,
    EvaluatorCore
  build-depends:       
    base ^>=4.19.0.0
  hs-source-dirs:      
    src
  default-language:    
    Haskell2010

executable WID3001-Assignment
    main-is: Main.hs
    build-depends: 
      base ^>=4.19.0.0,
      WID3001-Assignment
    hs-source-dirs: app
    default-language: Haskell2010

test-suite WID3001-Assignment-Tets
    type:             exitcode-stdio-1.0
    main-is:          Tests.hs
    build-depends:    
        base ^>=4.19.0.0,
        HUnit,
        WID3001-Assignment
    
    hs-source-dirs:   test
    default-language: Haskell2010